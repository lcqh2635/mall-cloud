# ==========================================================
# 全局环境变量配置文件（根目录）
# 说明：集中管理镜像版本、安全凭证、端口映射与JVM限制，避免硬编码散落
# ==========================================================

# --- 基础镜像版本 ---
PG_IMAGE=postgres:16-alpine  # PostgreSQL 官方精简镜像标签
REDIS_IMAGE=redis:7-alpine   # Redis 官方精简镜像标签
NACOS_IMAGE=nacos/nacos-server:v2.3.0  # Nacos 服务端官方镜像标签
RMQ_IMAGE=apache/rocketmq:5.1.4  # RocketMQ 统一官方镜像标签
SENTINEL_IMAGE=bladex/sentinel-dashboard:1.8.7  # Sentinel 控制台社区维护镜像
SEATA_IMAGE=seataio/seata-server:1.7.1  # Seata 协调器官方镜像标签

# --- 数据库与安全凭证（生产务必替换） ---
PG_USER=nacos_admin  # PostgreSQL 专属管理员账号
PG_PASSWORD=SecurePgPass2026!  # PostgreSQL 高强度连接密码
PG_DB=nacos_config  # Nacos 专用配置与元数据存储库名
NACOS_TOKEN=SecretNacosToken2026!  # Nacos 鉴权加密盐值
REDIS_PASSWORD=SecureRedisPass2026!  # Redis 访问认证密码

# --- 端口规划（避免与宿主机服务冲突） ---
PG_PORT=5432  # PostgreSQL 标准 TCP 端口
REDIS_PORT=6379  # Redis 标准 TCP 端口
NACOS_HTTP=8848  # Nacos Web 控制台与 REST API 端口
NACOS_GRPC_CLIENT=9848  # Nacos gRPC 客户端注册与配置拉取端口
NACOS_GRPC_SERVER=9849  # Nacos gRPC 服务端集群数据同步端口
RMQ_NAMESRV=9876  # RocketMQ NameServer 路由注册端口
RMQ_BROKER=10911  # RocketMQ Broker 消息收发核心端口
SENTINEL_PORT=8080  # Sentinel 流量控制控制台端口
SEATA_PORT=8091  # Seata 全局事务协调 RPC 端口

# --- JVM 内存限制（按开发机规格按需调整） ---
JVM_XMS_NACOS=256m  # Nacos JVM 初始堆内存
JVM_XMX_NACOS=512m  # Nacos JVM 最大堆内存
JVM_XMS_RMQ=256m  # RocketMQ JVM 初始堆内存
JVM_XMX_RMQ=512m  # RocketMQ JVM 最大堆内存