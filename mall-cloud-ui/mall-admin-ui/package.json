{
  "name": "mall-admin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A project built with Bun",
  "author": {
    "name": "龙茶清欢",
    "email": "lcqh2635@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.20"
  },
  "scripts": {
    "dev": "bun run --bun vite",
    "test": "bun run --bun vitest",
    "prod": "bun run --bun vite",
    "build": "bun run --bun vue-tsc --noEmit && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:android": "tauri android build",
    "tauri:build:ios": "tauri ios build",
    "distribute": "bun run tauri:build",
    "docs:dev": "bun run --bun vitepress dev docs --open",
    "docs:build": "bun run --bun vitepress build docs",
    "docs:preview": "bun run --bun vitepress preview docs",
    "commit": "cz",
    "preinstall": "bunx only-allow bun",
    "postinstall": "bun run scripts/setup.ts",
    "prepare": "bun run scripts/prepare.ts",
    "update": "bun update && cargo update --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.4",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "axios": "^1.16.1",
    "echarts": "^6.0.0",
    "figlet": "^1.11.0",
    "gsap": "^3.15.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "screenfull": "^6.0.2",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@intlify/unplugin-vue-i18n": "^11.2.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/figlet": "^1.7.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/reset": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.6",
    "@vue/tsconfig": "^0.9.1",
    "boxen": "^8.0.1",
    "postcss": "^8.5.14",
    "postcss-preset-env": "^11.3.0",
    "sass": "^1.99.0",
    "typescript": "~5.6.2",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lcqh2635/tauri-bun-ts.git"
  },
  "bugs": {
    "url": "https://github.com/lcqh2635/tauri-bun-ts/issues"
  },
  "homepage": "https://github.com/lcqh2635/tauri-bun-ts",
  "keywords": [
    "vue3",
    "typescript",
    "bun"
  ],
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
