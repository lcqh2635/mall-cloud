{
  "name": "mall-admin-ui",
  "type": "module",
  "description": "A project built with Bun",
  "author": {
    "name": "龙茶清欢",
    "email": "lcqh2635@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "comments": "// -b, --bun  强制脚本或包使用 Bun 的运行时而不是 Node.js",
    "dev": "bun run --bun vite --mode .env.development",
    "test": "bun run --bun vitest --mode .env.test",
    "prod": "bun run --bun vite --mode .env.production",
    "build": "bun run --bun vue-tsc --noEmit && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "tauri": "tauri",
    "tauri:dev": "bun run --bun tauri dev",
    "tauri:build": "bun run --bun tauri build",
    "tauri:build:android": "bun run --bun tauri android build",
    "tauri:build:ios": "bun run --bun tauri ios build",
    "distribute": "bun run --bun tauri build",
    "format": "bun run --bun prettier --write .",
    "preinstall": "npx only-allow bun",
    "postinstall": "echo '依赖包下载完成...'",
    "update": "bun update && cargo update --manifest-path src-tauri/Cargo.toml",
    "docs:dev": "bun run --bun vitepress dev docs --open",
    "docs:build": "bun run --bun vitepress build docs",
    "docs:preview": "bun run --bun vitepress preview docs"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --files-ignore-unknown=true",
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --organize-imports-enabled=false --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.4",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "axios": "^1.16.1",
    "echarts": "^6.0.0",
    "figlet": "^1.11.0",
    "gsap": "^3.15.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "screenfull": "^6.0.2",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@intlify/unplugin-vue-i18n": "^11.2.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/figlet": "^1.7.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/reset": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.6",
    "postcss": "^8.5.14",
    "postcss-preset-env": "^11.3.0",
    "sass": "^1.99.0",
    "typescript": "~5.6.2",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.1.10"
  }
}
